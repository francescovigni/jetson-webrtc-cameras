# Copy this file to `.env` and fill in your Tailscale auth key.
# Create a key at: https://login.tailscale.com/admin/settings/keys
# A reusable + ephemeral key is convenient for a redeployable device.
#
# NOTE: nothing in this project currently uses TS_AUTHKEY. Tailscale runs on
# the Jetson HOST, not in a container, so `script.sh` does not copy `.env` and
# `docker-compose.yml` does not read it. This file is kept for the day a
# tailscale sidecar comes back. Treat any key you put in `.env` as a cleartext
# secret sitting on disk doing nothing — don't paste a live one here "to test".
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
